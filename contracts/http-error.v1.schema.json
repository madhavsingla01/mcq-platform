{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quizfocus:contracts:http-error:v1",
  "title": "QuizFocus additive gateway error v1",
  "type": "object",
  "required": ["success", "message", "data", "error", "requestId"],
  "properties": {
    "success": { "const": false },
    "message": { "type": "string" },
    "data": { "type": "null" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
