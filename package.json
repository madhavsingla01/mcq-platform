{
  "name": "mcq-platform-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QuizFocus Microservices Platform",
  "scripts": {
    "test": "node tests/e2e/runner.js",
    "test:unit": "node --test tests/gateway-runtime.test.mjs tests/chat-settings-unit.test.mjs tests/architecture-contracts.test.mjs tests/frontend-api-contracts.test.mjs tests/media-accessibility-unit.test.mjs",
    "test:integration": "node scripts/verify-stack.mjs",
    "test:security": "node scripts/verify-stack.mjs --security",
    "test:security:production": "node scripts/verify-stack.mjs --production-auth",
    "test:media": "node scripts/verify-stack.mjs --media",
    "test:media:ui": "node --test tests/media-accessibility-ui.test.mjs",
    "verify:serve": "node scripts/verify-stack.mjs --serve",
    "db:check": "node scripts/database-check.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "install:all": "node scripts/install-all.js",
    "desktop:dev": "npm --prefix apps/desktop-web run dev",
    "desktop:build": "npm --prefix apps/desktop-web run build",
    "desktop:preview": "npm --prefix apps/desktop-web run preview",
    "mobile:dev": "npm --prefix apps/mobile-web run dev",
    "client:dev": "npm --prefix apps/desktop-web run dev",
    "services:all": "node scripts/start-all-services.js",
    "gateway:dev": "npm --prefix services/api-gateway run dev",
    "auth:dev": "npm --prefix services/auth-service run dev",
    "quiz:dev": "npm --prefix services/quiz-service run dev",
    "parser:dev": "npm --prefix services/parser-service run dev",
    "attempt:dev": "npm --prefix services/attempt-service run dev",
    "social:dev": "npm --prefix services/social-service run dev",
    "message:dev": "npm --prefix services/message-service run dev",
    "media:dev": "npm --prefix services/media-service run dev",
    "admin:dev": "npm --prefix services/admin-service run dev",
    "challenge:dev": "npm --prefix services/challenge-service run dev"
  }
}
