{
  "name": "@quizfocus/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the QuizFocus v1 authoring REST API",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/client.test.mjs",
    "prepack": "npm run build",
    "sync:contracts": "node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
